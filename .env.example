# TeachLab configuration. Copy to .env and fill in. Never commit .env.

# development | test | production  (production refuses AUTH_PROVIDER=local, LLM_PROVIDER=fake, SEARCH_PROVIDER=fixture)
ENV=development
LOG_LEVEL=INFO
LOG_JSON=false

# --- PostgreSQL (source of truth) -------------------------------------------------
DATABASE_URL=postgresql+asyncpg://teachlab:teachlab@localhost:5432/teachlab
TEST_DATABASE_URL=postgresql+asyncpg://teachlab:teachlab@localhost:5432/teachlab_test

# --- Qdrant (local Docker or Qdrant Cloud https://<cluster>.cloud.qdrant.io:6333) ---
# Leave QDRANT_URL empty to use embedded mode at QDRANT_PATH (":memory:" = ephemeral).
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_PATH=:memory:
QDRANT_COLLECTION_PREFIX=chunks

# --- LLM: Groq (OpenAI-compatible). Get a key at https://console.groq.com/keys ------
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Check https://console.groq.com/docs/models for current IDs and limits.
LLM_MODEL_SMART=openai/gpt-oss-120b
LLM_MODEL_FAST=openai/gpt-oss-20b
LLM_CONTEXT_TOKENS_SMART=32000
LLM_CONTEXT_TOKENS_FAST=32000
# Client-side throttle; set to your plan's tokens-per-minute limit.
LLM_TOKENS_PER_MINUTE=8000
# Reasoning models (gpt-oss): low | medium | high
LLM_REASONING_EFFORT=low
LLM_MAX_RETRIES=4

# --- Search: exa | tavily | fixture ------------------------------------------------
# Exa:    key at https://dashboard.exa.ai/api-keys
# Tavily: key at https://app.tavily.com
SEARCH_PROVIDER=exa
EXA_API_KEY=
TAVILY_API_KEY=
SEARCH_MAX_RESULTS=5
SEARCH_CACHE_TTL_HOURS=72

# --- Embeddings (local, CPU by default) --------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
# EMBEDDING_CACHE_DIR=./model_cache

# --- Storage (local filesystem for development) -------------------------------------
# local = filesystem; postgres = files stored in the database (needed when API and worker are separate services
# or the disk is ephemeral, as on Render)
STORAGE_BACKEND=local
STORAGE_DIR=./storage

# --- Public-deployment safety limits (0 = off). Protect your Groq/Exa quota from anonymous visitors. ---
DAILY_JOB_LIMIT_PER_USER=0
DAILY_JOB_LIMIT_GLOBAL=0
MAX_WORKSPACES_PER_USER=0

# --- Auth (local header auth; development/test only) ----------------------------------
# anonymous = no sign-in, each browser holds a private key (use this in production).
# local = X-User-Id header, trusts the caller (development/tests only).
AUTH_PROVIDER=anonymous
DEFAULT_USER_ID=local-teacher

# --- API --------------------------------------------------------------------------------
# comma-separated or JSON list; set to your Vercel URL(s) in production
CORS_ORIGINS=http://localhost:3000
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app   # optional: allow Vercel preview deployments

# --- Worker -----------------------------------------------------------------------------
# Run the job worker inside the API process (one service instead of two). Needs ~2 GB RAM for the embedding model.
RUN_WORKER_IN_API=false
WORKER_CONCURRENCY=2
WORKER_POLL_SECONDS=2
WORKER_LEASE_SECONDS=300

# --- Limits -------------------------------------------------------------------------------
MAX_UPLOAD_MB=20
FETCH_MAX_MB=15

# --- Assessment -----------------------------------------------------------------------------
# Runs model-generated Python reference solutions in a subprocess. Keep false unless the worker
# runs in an isolated container.
CODE_VERIFICATION_ENABLED=false

# --- Observability (optional: uv sync --extra otel) -------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Frontend (frontend/.env.local) ---------------------------------------------------------------
# NEXT_PUBLIC_API_URL=http://localhost:8000
