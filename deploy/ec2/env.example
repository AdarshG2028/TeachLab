# Copy to .env on the server (cp env.example .env) and fill in. Never commit .env.

# --- public hostname served by Caddy (HTTPS is automatic) ---
# With an Elastic IP 3.91.12.34 you can use the free wildcard DNS name:  3-91-12-34.nip.io
DOMAIN=

# --- app ---
ENV=production
LOG_JSON=true
AUTH_PROVIDER=anonymous
RUN_WORKER_IN_API=true
STORAGE_BACKEND=postgres
WORKER_CONCURRENCY=1
MALLOC_ARENA_MAX=2

# Your Vercel URL (no trailing slash). Several: comma-separated.
CORS_ORIGINS=

# --- data services (free tiers) ---
# Neon / Supabase connection string, postgres://user:pass@host/db?sslmode=require
DATABASE_URL=
# Qdrant Cloud: https://<id>.<region>.cloud.qdrant.io:6333
QDRANT_URL=
QDRANT_API_KEY=

# --- providers ---
LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_MODEL_SMART=openai/gpt-oss-120b
LLM_MODEL_FAST=openai/gpt-oss-20b
LLM_TOKENS_PER_MINUTE=8000
SEARCH_PROVIDER=exa
EXA_API_KEY=

# --- protect your API quota from anonymous visitors ---
DAILY_JOB_LIMIT_PER_USER=40
DAILY_JOB_LIMIT_GLOBAL=400
MAX_WORKSPACES_PER_USER=10
